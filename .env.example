# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection (used by web and smtp services)
POSTGRES_DB=dmarc
POSTGRES_USER=dmarc
POSTGRES_PASSWORD=change_me_now

# If you run outside Docker, set DATABASE_URL directly:
# DATABASE_URL=postgresql://dmarc:change_me_now@localhost:5432/dmarc

# ── Security ───────────────────────────────────────────────────────────────────
# Must be a long random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_64_char_random_hex_string

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,your.domain.example.com
TRUSTED_PROXIES=127.0.0.1

# ── Initial admin (created on first startup if set) ───────────────────────────
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_me_strong_password

# ── File uploads ───────────────────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads
RAW_MAIL_DIR=/data/raw_mail
MAX_UPLOAD_SIZE_MB=25

# ── SMTP Inbound ───────────────────────────────────────────────────────────────
# Hostname that appears in the SMTP banner and is used to build inbound addresses
SMTP_INBOUND_DOMAIN=reports.yourdomain.example.com
SMTP_INBOUND_HOST=0.0.0.0
SMTP_INBOUND_PORT=2525

# Optional TLS (leave empty to disable)
SMTP_TLS_CERT=
SMTP_TLS_KEY=

# Rate limits (per hour)
SMTP_IP_RATE_LIMIT=60
SMTP_RECIPIENT_RATE_LIMIT=30
SMTP_MAX_MESSAGE_SIZE=26214400

# ── Session ────────────────────────────────────────────────────────────────────
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPS_ONLY=true
SESSION_MAX_AGE=86400

# ── Features ───────────────────────────────────────────────────────────────────
FEATURE_SMTP_INBOUND=true
FEATURE_API=true
FEATURE_ALERTS=true

# ── Ports & image (docker-compose only) ───────────────────────────────────────
WEB_PORT=8765
SMTP_PORT=2525
# Pin to a specific release tag, e.g. v0.1.0 — defaults to "latest"
IMAGE_TAG=latest
