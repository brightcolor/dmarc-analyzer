# DMARC Analyzer – Einstellungen
# Kopiere diese Datei nach .env und passe die Werte an. Jede Einstellung hat eine Vorgabe;
# hier stehen die, die du für den Betrieb setzen solltest, und die, die man oft ändert.

# ── Datenbank (Docker Compose) ────────────────────────────────────────────────────
POSTGRES_DB=dmarc
POSTGRES_USER=dmarc
POSTGRES_PASSWORD=bitte-einen-eigenen-wert-setzen
# Ohne Docker die Verbindung direkt angeben:
# DATABASE_URL=postgresql://dmarc:passwort@localhost:5432/dmarc

# ── Sicherheit und Adresse ───────────────────────────────────────────────────────
# Langer Zufallswert, etwa: python -c "import secrets; print(secrets.token_hex(32))"
# Ohne eigenen Wert gelten Anmeldungen nur bis zum nächsten Neustart.
SECRET_KEY=bitte-einen-eigenen-wert-setzen
# Öffentliche Adresse der Weboberfläche; für den Hinweis zur Ersteinrichtung und die Links in Mails
APP_URL=https://dmarc.example.com
# Reverse-Proxys, deren X-Forwarded-For die Anwendung glaubt: Adressen oder Netze, durch Komma getrennt
TRUSTED_PROXIES=127.0.0.1
# Weitere Adressen der Oberfläche, von denen Formulare kommen dürfen; APP_URL gilt immer
CSRF_TRUSTED_ORIGINS=
# Sitzungscookie nur über HTTPS senden; hinter einem HTTPS-Proxy auf true lassen
SESSION_HTTPS_ONLY=true
# Gültigkeit einer Anmeldung in Sekunden (Vorgabe 7 Tage)
SESSION_MAX_AGE=604800
# Mindestlänge für Passwörter
PASSWORD_MIN_LENGTH=10
# Sperre gegen Raten: Fehlversuche je Konto und je Adresse im Zeitraum, Zeitraum und Sperrdauer in Sekunden
LOGIN_MAX_FAILURES_PER_ACCOUNT=10
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
LOGIN_ATTEMPT_RETENTION_DAYS=30

# ── Mailempfang für Berichte ──────────────────────────────────────────────────────
SMTP_INBOUND_ENABLED=true
# Domain der Empfangsadressen; braucht einen MX-Eintrag auf diesen Server
SMTP_INBOUND_DOMAIN=reports.example.com
SMTP_INBOUND_PORT=2525
# Größte Mail in Bytes
SMTP_INBOUND_MAX_MESSAGE_SIZE=10485760
# Mails je Stunde und IP-Adresse beziehungsweise je Empfangsadresse
SMTP_INBOUND_RATE_LIMIT_PER_IP=60
SMTP_INBOUND_RATE_LIMIT_PER_RECIPIENT=120
# STARTTLS mit eigenem Zertifikat (Pfade im Container)
SMTP_INBOUND_TLS_ENABLED=false
SMTP_INBOUND_TLS_CERT_PATH=
SMTP_INBOUND_TLS_KEY_PATH=
# Rohmails aufbewahren und wie lange
SMTP_INBOUND_STORE_RAW=false
SMTP_INBOUND_RAW_RETENTION_DAYS=7
# Tage, die abgelehnte Zustellversuche in der Liste bleiben
SMTP_REJECTION_RETENTION_DAYS=30

# ── Mailversand für Alarme und Wochenbericht ─────────────────────────────────────
# Leer lassen schaltet den Mailversand aus; Webhook, ntfy und Slack funktionieren weiter.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
# starttls, ssl oder none
MAIL_SMTP_SECURITY=starttls
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM=DMARC Analyzer <dmarc@example.com>
MAIL_TIMEOUT_SECONDS=20

# ── Wochenbericht ──────────────────────────────────────────────────────────────
# Wochentag (0 = Montag bis 6 = Sonntag) und Stunde in DISPLAY_TIMEZONE
DIGEST_WEEKDAY=0
DIGEST_HOUR=8
# Tage, die der Bericht zusammenfasst, und Einträge je Liste
DIGEST_PERIOD_DAYS=7
DIGEST_LIST_LIMIT=5

# ── Alarme ─────────────────────────────────────────────────────────────────────
# Schwellen für Regeln ohne eigene Schwelle: Quoten in Prozent, Mengen als Anzahl
ALERT_DEFAULT_FAIL_RATE=10
ALERT_DEFAULT_AUTH_FAIL_RATE=20
ALERT_DEFAULT_HIGH_VOLUME=500
ALERT_DEFAULT_NEW_SOURCE_FAILURES=1
ALERT_DEFAULT_VOLUME_SPIKE=200
ALERT_DEFAULT_VOLUME_DROP=80
ALERT_DEFAULT_IMPORT_FAILURES=1
ALERT_DEFAULT_INVALID_RECIPIENTS=20
ALERT_DEFAULT_RATE_LIMIT_HITS=10
# Anzahl früherer Zeiträume für den Durchschnitt der Mengenalarme
ALERT_VOLUME_BASELINE_WINDOWS=7
# Benachrichtigungen: neue Versuche, erste Wartezeit in Sekunden (verdoppelt sich), Zeitlimit in Sekunden
NOTIFICATION_RETRY_MAX=3
NOTIFICATION_RETRY_DELAY_SECONDS=300
NOTIFICATION_HTTP_TIMEOUT_SECONDS=10
NOTIFICATION_BATCH_SIZE=100
# ntfy-Server für Kanäle ohne eigenen Server
NTFY_DEFAULT_URL=https://ntfy.sh
# Webhook, ntfy und Slack nur an öffentliche Adressen; interne Namen, die trotzdem erlaubt sind
NOTIFICATION_BLOCK_PRIVATE_TARGETS=true
NOTIFICATION_ALLOWED_INTERNAL_HOSTS=

# ── Absender mit Namen ─────────────────────────────────────────────────────────
# Hostname und Netzbetreiber jeder Quelle per DNS nachschlagen; aus: Erkennung nur über DKIM und SPF
SENDER_LOOKUP_ENABLED=true
SENDER_ASN_LOOKUP_ENABLED=true
# Takt in Sekunden, Quellen je Lauf, gleichzeitige Abfragen, Zeitlimit je Abfrage in Sekunden
SENDER_LOOKUP_INTERVAL_SECONDS=60
SENDER_LOOKUP_BATCH_SIZE=50
SENDER_LOOKUP_WORKERS=8
SENDER_LOOKUP_TIMEOUT_SECONDS=2
# Nach so vielen Tagen schlägt die Anwendung eine Quelle erneut nach
SENDER_LOOKUP_REFRESH_DAYS=30
# Eigener Absenderkatalog (JSON); leer für den eingebauten allein
SENDER_CATALOG_PATH=
# DNS-Server, durch Komma getrennt; leer für die des Systems
DNS_NAMESERVERS=
# Eigene Fassung der Public Suffix List für die Organisationsdomain; leer für die mitgelieferte
PUBLIC_SUFFIX_LIST_PATH=

# ── Zeitplaner und Aufräumen ────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
# Takte in Sekunden: Grundtakt, Alarmregeln, Benachrichtigungen, Wochenbericht-Suche, Aufräumen
SCHEDULER_TICK_SECONDS=30
ALERT_EVAL_INTERVAL_SECONDS=300
NOTIFICATION_DISPATCH_INTERVAL_SECONDS=60
DIGEST_CHECK_INTERVAL_SECONDS=900
RETENTION_INTERVAL_SECONDS=86400
# Höchstzahl Einträge je Art, die ein Aufräumlauf löscht
RETENTION_BATCH_SIZE=1000

# ── Dateien und Grenzen ─────────────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads
RAW_MAIL_DIR=/data/raw_mail
# Größte hochgeladene Datei in Bytes
UPLOAD_MAX_SIZE=10485760
# Größter Mailanhang, Höchstgröße nach dem Entpacken, Höchstzahl Dateien je ZIP
ARCHIVE_MAX_ATTACHMENT_BYTES=20971520
ARCHIVE_MAX_UNPACKED_BYTES=52428800
ARCHIVE_MAX_FILES=50
# Höchstzahl Datensätze je Bericht
DMARC_MAX_RECORDS_PER_REPORT=50000

# ── Oberfläche ─────────────────────────────────────────────────────────────────
DISPLAY_TIMEZONE=Europe/Berlin
# Tage im Verlaufsdiagramm, Einträge je Seite, Einträge in Kurzlisten
UI_CHART_DAYS=30
UI_PAGE_SIZE=25
UI_RECENT_LIMIT=10
# Ab welcher Bestehensquote in Prozent die Oberfläche grün und gelb zeigt
UI_PASS_RATE_GOOD=95
UI_PASS_RATE_WARN=75

# ── Empfehlungen ────────────────────────────────────────────────────────────────
RECOMMENDATION_WINDOW_DAYS=30
RECOMMENDATION_STALE_REPORT_DAYS=7
RECOMMENDATION_MIN_MESSAGES=100
RECOMMENDATION_QUARANTINE_PASS_RATE=95
RECOMMENDATION_REJECT_PASS_RATE=99

# ── Standardtarif für neue Organisationen ───────────────────────────────────────
DEFAULT_PLAN_MAX_DOMAINS=50
DEFAULT_PLAN_MAX_USERS=20
DEFAULT_PLAN_MAX_API_TOKENS=10
DEFAULT_PLAN_MAX_ALERT_RULES=50
DEFAULT_PLAN_MAX_INBOUND_ADDRESSES=50
DEFAULT_PLAN_REPORT_RETENTION_DAYS=365
DEFAULT_PLAN_SMTP_RATE_LIMIT_PER_HOUR=500
DEFAULT_PLAN_API_RATE_LIMIT_PER_HOUR=2000

# ── Nur für Docker Compose ──────────────────────────────────────────────────────
WEB_PORT=8765
SMTP_PORT=2525
# Auf einen Release festlegen, etwa v0.2.0; ohne Angabe gilt latest
IMAGE_TAG=latest
